# DataForge internal single-server deployment
DATAFORGE_ENV=internal
DATAFORGE_ROOT=/opt/dataforge
DATAFORGE_STATE_DIR=/srv/dataforge/state
DATAFORGE_DATAFLOW_PATH=/opt/dataflow

# Listen on the internal network. Restrict this port with the server firewall.
DATAFORGE_WEB_HOST=0.0.0.0
DATAFORGE_WEB_PORT=8000

# OpenAI-compatible model APIs. Replace these placeholders for your environment.
DATAFORGE_LLM_BASE_URL=http://127.0.0.1:8001/v1
DATAFORGE_LLM_MODEL=Qwen3-32B
DATAFORGE_LLM_API_KEY_ENV=
DATAFORGE_EMBEDDING_BASE_URL=http://127.0.0.1:8002/v1
DATAFORGE_EMBEDDING_MODEL=bce-embedding-base
DATAFORGE_EMBEDDING_DIMENSION=768
DATAFORGE_EMBEDDING_BATCH_SIZE=32
DATAFORGE_EMBEDDING_CONCURRENCY=1
DATAFORGE_EMBEDDING_API_KEY_ENV=
DATAFORGE_RERANKER_BASE_URL=http://127.0.0.1:8197/v1
DATAFORGE_RERANKER_MODEL=bge-reranker-large
DATAFORGE_RERANKER_API_KEY_ENV=

# Milvus on the same server. Change the URI when it is deployed separately.
DATAFORGE_VECTOR_STORE_KIND=milvus
DATAFORGE_MILVUS_URI=http://127.0.0.1:19530
DATAFORGE_MILVUS_DATABASE=default
DATAFORGE_MILVUS_COLLECTION_PREFIX=dataforge
DATAFORGE_MILVUS_TOKEN_ENV=

# MinerU remains reserved until its result adapter is enabled.
DATAFORGE_MINERU_MODE=disabled
DATAFORGE_MINERU_COMMAND=/opt/mineru/bin/mineru
DATAFORGE_MINERU_BACKEND=hybrid-auto-engine
